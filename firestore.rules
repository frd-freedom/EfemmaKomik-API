rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email in ['sp.freemusichub@gmail.com', 'predimahrobi@gmail.com'];
    }

    function isAdmin() {
      return isVerified() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'photoURL', 'role', 'plan',
        'apiKey', 'dailyLimit', 'requestsToday', 'requestsTotal',
        'status', 'createdAt', 'updatedAt', 'lastLoginAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL', 'role', 'plan',
        'apiKey', 'dailyLimit', 'requestsToday', 'requestsTotal',
        'status', 'createdAt', 'updatedAt', 'lastLoginAt'
      ])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
      && data.uid.matches('^[a-zA-Z0-9_\\-]+$') && data.uid == userId
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.photoURL is string && data.photoURL.size() <= 500
      && data.role is string && data.role in ['user', 'admin']
      && data.plan is string && data.plan in ['free', 'pro', 'admin_unlimited']
      && data.apiKey is string && data.apiKey.size() >= 12 && data.apiKey.size() <= 80
      && data.apiKey.matches('^kmk_[a-zA-Z0-9_]+$')
      && data.dailyLimit is int && (data.dailyLimit == -1 || (data.dailyLimit >= 0 && data.dailyLimit <= 10000000))
      && data.requestsToday is int && data.requestsToday >= 0 && data.requestsToday <= 10000000
      && data.requestsTotal is int && data.requestsTotal >= 0 && data.requestsTotal <= 1000000000
      && data.status is string && data.status in ['active', 'suspended']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && data.lastLoginAt is timestamp;
    }

    function isValidAdminDoc(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
      && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
      && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
      && data.uid.matches('^[a-zA-Z0-9_\\-]+$') && data.uid == userId
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
      && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128
      && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isVerified()
        && isValidUser(incoming(), userId)
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastLoginAt == request.time
        && incoming().requestsToday == 0
        && incoming().requestsTotal == 0
        && incoming().status == 'active'
        && (
          (isBootstrappedAdmin() && incoming().role == 'admin' && incoming().plan == 'admin_unlimited' && incoming().dailyLimit == -1)
          || (incoming().role == 'user' && incoming().plan == 'free' && incoming().dailyLimit >= 1 && incoming().dailyLimit <= 100000)
        );

      allow update: if isValidId(userId)
        && isVerified()
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().plan == existing().plan
            && incoming().dailyLimit == existing().dailyLimit
            && incoming().status == existing().status
            && incoming().requestsToday == existing().requestsToday
            && incoming().requestsTotal == existing().requestsTotal
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'updatedAt'])
              || incoming().diff(existing()).affectedKeys().hasOnly(['apiKey', 'updatedAt'])
            )
          )
        );

      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isAdmin()
        && isValidAdminDoc(incoming(), userId)
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId)
        && isAdmin()
        && isValidAdminDoc(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }
  }
}
